# nwn-mcp settings, read by the MCP server and by the command-line tools (node dist/cli/tool.js, quest.js).
# Copy to nwn-mcp.env (git-ignored) or point NWN_MCP_ENV at a file. A variable set in the environment wins.
# Without this file the command-line tools fall back to the env of the nwn-mcp entry in ~/.claude.json.

# neverwinter.nim binaries (nwn_gff, nwn_erf, nwn_script_comp, ...)
NIM_FOLDER_NWTOOLS=~/git/nwn-tools/linux/neverwinter
# NWN:EE game install (base 2DAs, TLK, tilesets)
NWN_FOLDER_DATA=~/nwn-data
# NWN user documents folder (override/, hak/, tlk/); resman needs it to read the 2DAs
NWN_FOLDER_USER=~/nwn-data/user
# Optional
# MCP_FOLDER_TEMP=/tmp/nwn-mcp
# MCP_FOLDER_ADVENTURES=~/git/Q-nwn-mcp/adventures
# MCP_FOLDER_USERREPORTS=
# MCP_FOLDER_VERIFYSERVER=~/nwn-mcp-verify-server
